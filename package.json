{
  "name": "enbox-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter @enbox/lab build",
    "lint": "bun run --filter @enbox/lab lint",
    "lint:fix": "bun run --filter @enbox/lab lint:fix",
    "setup:browser": "bun run --filter @enbox/lab setup:browser",
    "setup:browser:ci": "bun run --filter @enbox/lab setup:browser:ci",
    "test:coverage": "bun run --filter @enbox/lab test:node:coverage && bun packages/lab/src/ci/check-coverage.ts packages/lab/coverage/lcov.info 65",
    "test:node": "bun run --filter @enbox/lab test:node",
    "typecheck": "bun run --filter @enbox/lab typecheck",
    "verify:linux": "bun packages/lab/src/ci/verify-linux-proofs.ts"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@eslint/js": "9.3.0",
    "@stylistic/eslint-plugin": "2.13.0",
    "@types/bun": "1.3.14",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "eslint": "9.7.0",
    "eslint-plugin-mocha": "10.4.3",
    "globals": "15.6.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
