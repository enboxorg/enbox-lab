{
  "compilerOptions": {
    "lib": ["DOM", "ES2022"],
    "allowJs": false,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "target": "ES2022",
    "module": "NodeNext",
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist"]
}
