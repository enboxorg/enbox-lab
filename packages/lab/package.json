{
  "name": "@enbox/lab",
  "version": "0.0.0",
  "private": true,
  "description": "Local isolated Enbox environment controller and proof harnesses",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "enbox-lab": "./dist/esm/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "rm -rf dist/esm dist/types && bun tsc -p tsconfig.json",
    "build": "bun run clean && bun run build:esm",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test:node": "bun test --max-concurrency=1 --timeout 30000 .spec.ts",
    "test:node:coverage": "bun test --max-concurrency=1 --timeout 30000 --coverage --coverage-skip-test-files --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage .spec.ts",
    "typecheck": "bun tsc --noEmit -p tsconfig.json && bun tsc --noEmit -p tests/tsconfig.json"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox-lab.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@enbox/browser": "0.3.79",
    "@enbox/connect": "0.1.23",
    "@enbox/crypto": "0.1.11",
    "@enbox/dids": "0.1.12",
    "playwright": "1.55.1"
  }
}
